<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="https://innatureproject.github.io/innatureimages/favicon.ico" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-KK94CHFLLe+nY2dmCWGMq91rCGa5gtU4mk92HdvYe+M/SXH301p5ILy+dN9+nJOZ" crossorigin="anonymous">
    <!-- <link rel="stylesheet" href="css/cssGeral.css"> -->
    <%- include("css/cssGeral") %>
    <!-- <link rel="stylesheet" href="css/cadastro-planta.css"> -->
    <!-- <link rel="stylesheet" href="css/forms.css"> -->
    <%- include("css/forms") %>
    <!-- <script src="js/geralJs.js" defer></script> -->
    <!-- <script src="js/cadastro-planta.js" defer></script> -->
    <%- include("css/cadastro-planta") %>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <title>Novas informações</title>
</head>
<body>
    <%- include("objects/navbar"); %>


    <main class="flex-grow-1">
        <div class="container d-flex justify-content-center">
            <div class="formm">
            <form class = "form" method="post">
                
    
                        <h1>Preparo</h1>
    
                        <label class="form-label" for="cd_nome">Título</label>
                        <input type="text" class="form-control" name="cd_nome" id="cd_titulo" required>
                        <label class="form-label" for="cd_descricao">Descrição</label>
                        <textarea type="text" class="form-control" name="cd_descricao" id="cd_descricao" row="10" required></textarea>
                        
    

                        <div>
                            <label class="form-label">Tipo de Preparo</label>
                            <div>
                                <input type="radio" name="a" id="banho" class="tipo_preparo">
                                <label for="cha">Banho</label>
                            </div>
                            <div>
                                <input type="radio" name="a" id="inalacao" class="tipo_preparo">
                                <label for="banho">Inalação</label>
                            </div>
                            <div>
                                <input type="radio" name="a" id="cha" class="tipo_preparo">
                                <label for="cha">Chá</label>
                            </div>
                            <div>
                                <input type="radio" name="a" id="compressa" class="tipo_preparo">
                                <label for="compressa">Compressa</label>
                            </div>
                        </div>

                        <input type="button" onclick="javascript: hide_show('indicacao')" value="Indicação">
                        <input type="button" onclick="javascript: hide_show('contraindicacao')" value="Contra Indicação">
                        <input type="button" onclick="javascript: hide_show('efeitocolateral')" value="Efeito Colateral">
                        <input type="button" onclick="javascript: pesquisa_planta()" value="Planta">
                        <p id="cd_planta" class="fs-6 mx-3 mt-1">Planta: </p>
                        
            </form>
            <input class="form-submit"  type="submit" id="submit" value="Cadastrar" onclick="javascript: dados()"><br>

        </div>
        </div>
    </main>
    <div id="pesquisa-indicacao" class="bg-info pesquisa-ice hide rounded-2">
        <p onclick="javascript: hide_show('indicacao')" class="x_button">X</p>
        <% for (let i = 0; i < propriedades.indicacao.length; i++)  {%>
            <input class="itens" type="button" value="<%= propriedades.indicacao[i] %>" v="<%= propriedades.indicacaon[i] %>" e="false">
        <% } %>
    </div>
    <div id="pesquisa-contraindicacao" class="bg-info pesquisa-ice hide">
        <p onclick="javascript: hide_show('contraindicacao')" class="x_button">X</p>
        <% for (let i = 0; i < propriedades.contraindicacao.length; i++)  {%>
            <input class="itens" type="button" value="<%= propriedades.contraindicacao[i] %>" v="<%= propriedades.contraindicacaon[i] %>" e="false">
        <% } %>
    </div>
    <div id="pesquisa-efeito-colateral" class="bg-info pesquisa-ice hide">
        <p onclick="javascript: hide_show('efeitocolateral')" class="x_button">X</p>
        <% for (let i = 0; i < propriedades.efeito_colateral.length; i++)  {%>
            <input class="itens" type="button" value="<%= propriedades.efeito_colateral[i] %>" v="<%= propriedades.efeito_colateraln[i] %>" e="false">
        <% } %>
    </div>


    <%- include("objects/footer"); %>
    <script defer>
        const pesq = document.getElementById("pesq");
        const add = document.getElementById("add");
        const indica = document.getElementById("indicacao");

        add.addEventListener('click', (e) => {
            let cel = document.createElement("div");
            cel.className = "border-1";
            cel.textContent = pesq.value;
            pesq.value = '';
            indica.appendChild(cel);
            
        })
    </script>
    <%- include("js/cadastro-preparo") %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ENjdO4Dr2bkBIFxQpeoTz1HIcje39Wm4jDKdf19U8gI4ddQ3GYNS7NTKfAdVQSZe" crossorigin="anonymous"></script>
</body>
</html>