<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="https://innatureproject.github.io/innatureimages/favicon.ico" type="image/x-icon">
    <title>Erro</title>
    <style>
        div {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            
        }

        h1 {
            margin-bottom: 1em;
            font-size: 4em;
        }

        h2 {
            color: blue;
            text-decoration: underline;
        }

        h2:hover {
            cursor: pointer;
        }
    </style>
</head>
<body style="height: 90vh;">
    <div>
        <h1>Erro: <%= erro %></h1>
        <br>
        <h2 onclick="window.location.pathname = 'index'">Voltar para a página inicial</h2>
    </div>
</body>
</html>