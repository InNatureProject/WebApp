<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="https://innatureproject.github.io/innatureimages/favicon.ico" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-KK94CHFLLe+nY2dmCWGMq91rCGa5gtU4mk92HdvYe+M/SXH301p5ILy+dN9+nJOZ" crossorigin="anonymous">
    <!-- <link rel="stylesheet" href="/css/cssGeral.css"> -->
    <%- include("css/cssGeral") %>
    <!-- <link rel="stylesheet" href="/css/cadastro-planta.css"> -->
    <%- include("css/cadastro-planta") %>
    <!-- <link rel="stylesheet" href="/css/forms.css"> -->
    <%- include("css/forms") %>
    <!-- <script src="js/geralJs.js" defer></script> -->
    <!-- <script src="/js/cadastro-planta.js" defer></script> -->

    
    <title>Novas informações</title>
</head>
<body>
    <%- include("objects/navbar"); %>


    <main class="flex-grow-1">
        <div class="container d-flex justify-content-center">
            <div class="formm">
            <form class = "form">
                
    
                        <h1>Cadastro das Plantas</h1>
    
                        <label class="form-label" for="cd_nome">Nome</label>
                        <input type="text" class="form-control" name="cd_nome" id="cd_nome" required>
                        <div class = "alert" id = "alerta1">O campo não pode estar vazio!</div>
                        <div class = "alert" id = "alerta5">Favor inserir apenas letras e espaços!!</div>

                        <label for="indicacao">Indicação</label>
                        <div class="indicacoes" id="indicacoes"></div>
                        <input type="button" onclick="javascript: hide_show('indicacao')" value="ok">
                        
    
                        <label for="contraindicacao">Contra Indicação</label>
                        <div class="contraindicacoes" id="contraindicacoes"></div>
                        <input type="button" onclick="javascript: hide_show('contraindicacao')" value="ok">

                            
                        <label for="efeito-colateral">Efeito Colateral</label>
                        <div class="efeitos-colaterais" id="efeito-colateral"></div>
                        <input type="button" onclick="javascript: hide_show('efeitocolateral')" value="ok">


                        <label for=""></label>
    

                        
            
            </form>
            <input class="form-submit"  type="submit" id="submit" value="Próximo"><br>

        </div>
        </div>
    </main>
    <div id="pesquisa-indicacao" class="bg-info pesquisa-ice hide">
        <p onclick="javascript: hide_show('pesquisa-indicacao')">X</p>
        <% for (let i = 0; i < propriedades.indicacao.length; i++)  {%>
            <input type="button" value="<%= propriedades.indicacao[i] %>">
        <% } %>
    </div>
    <div id="pesquisa-contraindicacao" class="bg-info pesquisa-ice hide"></div>
    <div id="pesquisa-efeito-colateral" class="bg-info pesquisa-ice hide"></div>
    <%- include("objects/footer"); %>
    <%- include("js/cadastro-planta") %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ENjdO4Dr2bkBIFxQpeoTz1HIcje39Wm4jDKdf19U8gI4ddQ3GYNS7NTKfAdVQSZe" crossorigin="anonymous"></script>
</body>
</html>