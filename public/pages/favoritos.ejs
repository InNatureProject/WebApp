<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="https://innatureproject.github.io/innatureimages/favicon.ico" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-KK94CHFLLe+nY2dmCWGMq91rCGa5gtU4mk92HdvYe+M/SXH301p5ILy+dN9+nJOZ" crossorigin="anonymous">
    <title>Favoritos</title>
</head>
<body>
    <%- include("objects/navbar"); %>
    
    <main class="mt-4 flex-grow-1">
        <div class="container d-flex justify-content-center">
            <p class="fs-1 me-auto">Plantas</p>
        </div>
        <div class="container p-2">
            <div class="container rounded-5 bg-light" id="plantas">
                <% for (var i = 0; i < plantas.length; i++) { %>
                    <div>
                        <a onclick="window.location.pathname = 'planta/<%=plantas[i]['cod_plt'];%>'" class="text-decoration-none text-black">
                        <img src=<%= plantas[i]["imagem"]; %> href=<%= "planta/" + plantas[i]["cod_plt"]; %>>
                        <p class="text-decoration-none"><%= plantas[i]["nome"];%></p>
                    </a>
                    </div>

                    <% } %>
            </div>
        </div>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ENjdO4Dr2bkBIFxQpeoTz1HIcje39Wm4jDKdf19U8gI4ddQ3GYNS7NTKfAdVQSZe" crossorigin="anonymous"></script>
</body>
