<script defer>
const favoritar = true;
const comentario = document.getElementById("comentario");
const comentarBotao = document.getElementById("comentar");
var cookies = {};
document.cookie.split(";").forEach((i) => {
  let data = i.split("=");
	cookies[data[0]] = data[1];
})

var Token = '';
var star = document.querySelector("img.favorito");

if (cookies['Token'] == undefined) {
  if (cookies[' Token'] == undefined) {
    Token = "";
  } else {
    Token = cookies[' Token'];
  }
} else {
  Token = cookies['Token'];
}

function favorite() {
  if (favoritar) {
    axios.post(window.location.origin.concat('/api/users/favoritar'), {
      Token: Token,
      Planta: sessionStorage.getItem("planta")
      }).then(response => { 
          if (response.data.erro) {
              return alert("response.data.erro")
          } else {
            console.log(response);
              if (response.data.info == "Favoritado") {
                star.src = "https://innatureproject.github.io/innatureimages/filled_star.png"
              } 
              if (response.data.info == "Desfavoritado") {
                star.src = "https://innatureproject.github.io/innatureimages/outlined_star.png"
              }
          }
      }).catch(erro => {
          return alert("Erro");
      })
  } 
}

const cabecalho = document.querySelectorAll(".accordion-cabecalho");

// funções do accordion

function toggleAccordion(event) {
  const cabecalho = event;
  const conteudo = cabecalho.nextElementSibling;

  if (conteudo.style.display === "none" || conteudo.style.display === "") {
    // fechaTodosAccordionContent();
    conteudo.style.display = "block";
    cabecalho.setAttribute("children", "show");
  } else {
    conteudo.style.display = "none";
    cabecalho.setAttribute("children", "hide");
  }
}

function fechaTodosAccordionContent() {
  const conteudo = document.querySelectorAll(".accordion-conteudo");
  conteudo.forEach((e) => {
    e.style.display = "none";
  })
}


fechaTodosAccordionContent();

function Comentar(descricao, planta) {
  axios.post(window.location.origin.concat('/api/users/comentar'), {
    Planta: planta, Descricao: descricao,
  }).then(response => {
    console.log(response);
    if (response.data.erro) {
      console.log(response.data.erro);
    } else {
      comentario.value = '';
    }
  }).catch(erro => {
    console.log(erro);
    alert('Erro');
  })
}

comentarBotao.addEventListener('click', (e) => {
  if (comentario.value != '') {
    Comentar(comentario.value, sessionStorage.planta);
  }
})
</script>