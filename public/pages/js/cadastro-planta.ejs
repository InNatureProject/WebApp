<script defer>



const telas = {
    contraindicacao: document.querySelector('#pesquisa-contraindicacao'),
    indicacao: document.querySelector('#pesquisa-indicacao'),
    efeitocolateral: document.querySelector('#pesquisa-efeito-colateral'),
}

const itens = document.querySelectorAll('.itens');

itens.forEach((e) => {
    e.addEventListener('click', (event) => {
        if (e.getAttribute('v') == 'true') {
            e.setAttribute('v', 'false')
        } else {
            e.setAttribute('v', 'true');
        }
    })
})

function dados() {
    let nome = document.getElementById("cd_nome").value;
    let nome_cientifico = document.getElementById("cd_nome_cientifico").value;
    let descricao = document.getElementById("cd_descricao").value;
    let imagem = document.getElementById("cd_imagem").value;

    axios.post("api/planta/cadastrarPlanta", {
        nome: nome, nome_cientifico: nome_cientifico, descricao: descricao, imagem: imagem
    }).then(response => {
        if (response.data.erro) {
                alert("Erro")
            } else {
                alert("Planta Cadastrada");
            }
    })
}
</script>