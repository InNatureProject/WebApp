<!-- <!DOCTYPE html> -->
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-KK94CHFLLe+nY2dmCWGMq91rCGa5gtU4mk92HdvYe+M/SXH301p5ILy+dN9+nJOZ" crossorigin="anonymous">
    <!-- <link rel="stylesheet" href="/css/cssGeral.css"> -->
    <%- include("css/cssGeral") %>
    <!-- <link rel="stylesheet" href="/css/planta.css"> -->
    <%- include("css/planta") %>
    <!-- <script src="js/geralJs.js" defer></script> -->
    <!-- <script src="/js/planta.js" defer></script> -->
    <%- include("js/planta") %>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <title>Plantas</title>
</head>
<body>
    <!-- header e modal juntos -->
    <%- include("objects/navbar"); %>

    <main class="flex-grow-1">
        <div class="container mt-4">
            <a class="nav-link" onclick="history.go(-1)"><svg xmlns="http://www.w3.org/2000/svg" width="1.5rem" height="1.5rem" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
              </svg></a>
            
            <div class="table container-fluid">
                <div class="row">
                    <div class="col-1 d-flex flex-row">
                        <img class="rounded-5" src=<%= planta[0]["imagem"] %> alt="" id = "imagem">
                        <img src="https://innatureproject.github.io/innatureimages/outlined_star.png" alt="" class="favorito md-0 mt-auto" height="50em" width="50em">
                    </div>
                    <div class="col-5 container-fluid d-flex">
                        <p class="fs-1 my-auto mx-auto" id="nome"><%= planta[0]["nome"] %></p>
                    </div>
                </div>
                <div class="row preparos">
                    
                    <% for (var i = 0; i < preparos.length; i++) { 
                        let indicacoes = "";
                        indicacoes = "Indicacoes:  " + preparos[i]["indicacao"][0];
                        for (let j = 1; j < preparos[i]["indicacao"].length-1; j++) {
                            indicacoes = indicacoes.concat(", " + preparos[i]["indicacao"][j]);
                        }
                        if (preparos[i]["indicacao"].length > 1) {
                            indicacoes = indicacoes.concat(" e " + preparos[i]["indicacao"].slice(-1));
                        }

                        
                        let contraindicacoes = "";
                        contraindicacoes = "Contraindicacoes:  " + preparos[i]["contraindicacao"][0];
                        for (let j = 1; j < preparos[i]["contraindicacao"].length-1; j++) {
                            contraindicacoes = contraindicacoes.concat(", " + preparos[i]["contraindicacao"][j]);
                        }
                        if (preparos[i]["contraindicacao"].length > 1) {
                            contraindicacoes = contraindicacoes.concat(" e " + preparos[i]["contraindicacao"].slice(-1));    
                        }
                        

                        let efeitos_colaterais = "";
                        efeitos_colaterais = "Efeitos Colaterais:  " + preparos[i]["efeito colateral"][0];
                        for (let j = 1; j < preparos[i]["efeito colateral"].length-1; j++) {
                            efeitos_colaterais = efeitos_colaterais.concat(", " + preparos[i]["efeito colateral"][j]);
                        }
                        if (preparos[i]["efeito colateral"].length > 1) {
                            efeitos_colaterais = efeitos_colaterais.concat(" e " + preparos[i]["efeito colateral"].slice(-1));
                        }

                        %>
                    <div>
                        <div class="preparo text-justify">
                            <div class="accordion-cabecalho fs-3 text-justify" children="hide" onClick="toggleAccordion(this)">
                                <%= preparos[i]["titulo"] %>
                            </div>

                            <div class="accordion-conteudo fs-4 text-justify" style="display: none">
                                <p class="fs-4 text-justify">Tipo: <%= preparos[i]["tipo_preparo"] %></p>
                                <p class="fs-5 text-justify"><%= preparos[i]["receita"] %></p>
                                <p class="fs-6 text-justify"><%= indicacoes %></p>
                                <p class="fs-6 text-justify"><%= contraindicacoes %></p>
                                <p class="fs-6 text-justify"><%= efeitos_colaterais %></p>
                                <p class="fs-6 text-justify"></p>
                            </div>
                        </div>
                    </div>
                    <% } %>

                </div>
            </div>
        </div>
    </main>

    <%- include("objects/footer"); %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ENjdO4Dr2bkBIFxQpeoTz1HIcje39Wm4jDKdf19U8gI4ddQ3GYNS7NTKfAdVQSZe" crossorigin="anonymous"></script>
</body>
</html>
